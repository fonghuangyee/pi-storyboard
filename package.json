{
  "name": "pi-storyboard",
  "version": "0.1.0",
  "description": "Render validated Pi assistant turns as source-ordered storyboards with grouped tool actions and native fallbacks.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fonghuangyee/pi-storyboard.git"
  },
  "homepage": "https://github.com/fonghuangyee/pi-storyboard#readme",
  "bugs": {
    "url": "https://github.com/fonghuangyee/pi-storyboard/issues"
  },
  "sideEffects": false,
  "keywords": ["pi-package", "pi-extension", "tui", "tool-calls"],
  "files": ["src", "README.md", "LICENSE"],
  "pi": {
    "extensions": ["./src/index.ts"]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": { "optional": true },
    "@earendil-works/pi-tui": { "optional": true }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "@types/node": "26.5.1",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "transcript:schema": "node scripts/sync-transcript-schema.mjs",
    "transcript:schema:update": "node scripts/sync-transcript-schema.mjs --update",
    "package:check": "npm pack --dry-run",
    "prepublishOnly": "npm run check && npm run package:check"
  }
}
